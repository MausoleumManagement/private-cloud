# see here for complete reference:
# https://github.com/kubernetes-sigs/cluster-api-provider-openstack/blob/main/docs/book/src/clusteropenstack/configuration.md


#Optional Variables:
export KUBERNETES_VERSION=v1.35.9

# TODO: make sure, that this flavour is not one of those with inbuilt volumes, lmao
export OPENSTACK_CONTROL_PLANE_MACHINE_FLAVOR=SCS-2V-4-20
export OPENSTACK_FAILURE_DOMAIN=az1
export OPENSTACK_IMAGE_NAME=ubuntu-2604-kube-v1.35.9
export OPENSTACK_NODE_MACHINE_FLAVOR=SCS-2V-4-20
export OPENSTACK_SSH_KEY_NAME=leon-ed25519
# TODO: we can and should pass multiple here
export OPENSTACK_DNS_NAMESERVERS=9.9.9.9
# we could use the id of the default external network
# but publicising that feels weird
# instead, we use a name filter, which we patch in via yq
export OPENSTACK_EXTERNAL_NETWORK_ID=dummy

#Optional Variables:
export CLUSTER_NAME=feywild
export CONTROL_PLANE_MACHINE_COUNT=3
export WORKER_MACHINE_COUNT=3

